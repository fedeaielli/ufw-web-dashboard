# Server Configuration
PORT=3300
HOST=127.0.0.1
NODE_ENV=production

# Authentication (REQUIRED)
# Use strong credentials! Minimum 12 characters recommended.
F_USER=admin
F_PASS=change_this_strong_password_123!

# Authentication Security
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_BLOCK_DURATION=900000  # 15 minutes in milliseconds
SESSION_TTL=43200000        # 12 hours of inactivity in milliseconds

# Logs Configuration
LOG_MAX_LINES=10000
LOG_DEFAULT_LINES=1000
LOG_CACHE_TTL=5000          # 5 seconds in milliseconds
LOG_MAX_CACHE_SIZE=10

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000         # 15 minutes in milliseconds
RATE_LIMIT_CLEANUP_INTERVAL=300000  # 5 minutes in milliseconds

# CSRF Protection
CSRF_TOKEN_EXPIRY=3600000      # 1 hour in milliseconds
CSRF_CLEANUP_INTERVAL=1800000  # 30 minutes in milliseconds

# Security
MIN_PASSWORD_LENGTH=12
MIN_USERNAME_LENGTH=4
